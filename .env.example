# =============================================================
# Percival AgentMail MCP — local Compose settings template
# Keep credential values in separate files outside this repository.
# Never commit those files or put credential values in this file.
# =============================================================

# Read-only secret files (the Compose service mounts them at /run/secrets).
AGENTMAIL_API_KEY_FILE=/home/you/.config/percival/agentmail_api_key
AGENTMAIL_INBOX_ID_FILE=/home/you/.config/percival/agentmail_inbox_id

# Maximum results returned by list endpoints (default: 25, capped at 50)
AGENTMAIL_MAX_RESULTS=25

# HTTP timeout in seconds for AgentMail API calls (default: 30)
AGENTMAIL_TIMEOUT=30
